# Bench Studio — configuração
#
# Copie para `.env` (na raiz do projeto) ou para `~/.env` e preencha o que for usar.
# NADA aqui é obrigatório em conjunto: o estúdio sobe com o que existir e mostra
# no catálogo o que está indisponível e por quê. Um provedor sem chave aparece
# desligado com a explicação, em vez de dar erro na hora da geração.
#
# Ordem de leitura: variável já exportada no ambiente > .env do projeto > ~/.env
#
# Tudo isto também pode ser conferido e preenchido pela tela: botão `Config`, no
# canto superior direito do estúdio. Ela mostra o que está presente e de onde
# veio, sem nunca exibir o valor, e grava neste arquivo. Por segurança, só
# aceita gravação vinda da própria máquina (com `--lan`, quem está na rede vê a
# tela em modo leitura).


# ─────────────────────────────────────────────── geração de imagem e vídeo

# fal.ai — 37 modelos (FLUX, Veo, Kling, Seedance, Hailuo, Wan, LTX, Grok...).
# Cobra em DÓLAR, com preço ao vivo por modelo. É o provedor de maior catálogo.
# Chave em https://fal.ai/dashboard/keys
FAL_KEY=

# Agnes AI — imagem e vídeo a CUSTO ZERO (sem créditos, sem cobrança).
# Exige prompt em inglês: a API filtra conteúdo legítimo em português.
# Gateway: https://apihub.agnes-ai.com
AGNES_API_KEY=

# kie.ai — agregador pago, cobrado em CRÉDITOS (Z-Image ~$0.004/img, Veo 3 fast...).
# Chave em https://kie.ai/api-key
KIE_API_KEY=

# Kling AI — NÃO usa chave: é o CLI oficial com login OAuth.
#   npm i -g @klingai/cli-global && kling login
# Consome créditos do seu plano Kling. Sem isso, os modelos Kling aparecem
# indisponíveis no catálogo. Regenerar o catálogo depois de logar:
#   node server/providers/kling_sync.mjs


# ─────────────────────────────────────────────── modelos locais (custo zero)

# inemaimg — servidor local de imagem (FLUX.2, Qwen-Edit, ERNIE) numa GPU sua.
# Repo: github.com/inematds/inemaimg · sobe com `docker compose up -d`
INEMAIMG_URL=http://127.0.0.1:8000

# ollama — usado pelo construtor de sites/documentos como motor local.
#   https://ollama.com · depois: ollama pull qwen3:30b
OLLAMA_URL=http://127.0.0.1:11434


# ─────────────────────────────────────────────── refino de prompt

# O refinador reescreve sua ideia no estilo que CADA modelo espera (e traduz
# para inglês, o que a Agnes exige). Ele tenta nesta ordem, e o primeiro que
# responder vence — ter mais de um evita que uma cota estourada derrube tudo:
#
#   1. Gemini      (GOOGLE_API_KEY)
#   2. OpenRouter  (OPENROUTER_API_KEY)
#   3. Codex local (nenhuma variável: usa o CLI já autenticado, se existir)

# Google AI Studio — https://aistudio.google.com/apikey
# Também habilita os modelos Gemini e Veo quando usados direto.
GOOGLE_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Confira em https://openrouter.ai/models se o modelo ainda existe: nomes são
# aposentados e um default velho devolve 404.
OPENROUTER_MODEL_DEFAULT=google/gemini-2.5-flash


# ─────────────────────────────────────────────── referência de qualidade (opcional)

# Um site/documento SEU que o construtor pode inspecionar para calibrar o nível
# de acabamento — ritmo de animação, densidade tipográfica, capricho de
# interação. Ele é proibido de copiar marca, texto, estrutura ou arquivos.
BENCH_WEBSITE_REFERENCE=
# Só para mostrar a prévia no painel lateral:
BENCH_WEBSITE_REFERENCE_URL=
BENCH_DOCUMENT_REFERENCE=


# ─────────────────────────────────────────────── senha do estúdio (opcional)

# VAZIO = SEM SENHA, e é assim que o estúdio vem: falar com a sua própria
# máquina não deveria pedir senha. Definindo uma, ela passa a proteger a API —
# modelos, resultados, mídia, ledger e configuração. A casca da interface
# continua sendo servida a quem alcança a porta, mas sem sessão não mostra nada;
# esconder também a casca é trabalho de proxy reverso, não deste processo.
#
# O valor aqui é um HASH scrypt, nunca a senha. Defina por um destes caminhos:
#   npm run set-password           (pergunta a senha, sem ecoar)
#   npm run set-password -- --remove
# ou pelo botão Config, no estúdio, estando na própria máquina.
#
# Esqueceu a senha? Apague esta linha e reinicie. Não há recuperação por e-mail —
# quem tem o arquivo já tem as chaves que estão nele, então nada seria protegido
# por um mecanismo mais elaborado.
BENCH_PASSWORD=


# ─────────────────────────────────────────────── ajustes do servidor (opcional)

# Porta da API (a interface roda em 5200).
PORT=8787

# Em que interface de rede cada parte escuta. O padrão é só a própria máquina.
# Não edite isto na mão: `./scripts/remote.sh open` publica a interface e
# `./scripts/remote.sh close` desfaz — inclusive a regra de firewall, que a
# variável sozinha não resolve.
#   BENCH_WEB_HOST=0.0.0.0    a interface aceita conexão de fora
#   BENCH_API_HOST=0.0.0.0    a API aceita conexão de fora (raramente se quer)
BENCH_WEB_HOST=127.0.0.1
BENCH_API_HOST=127.0.0.1
# Onde ficam banco, saídas e projetos. Padrão: ./data
BENCH_DATA_DIR=
# Chrome/Chromium para imprimir PDF. Detectado automaticamente; use isto só se
# estiver num caminho fora do comum.
BENCH_CHROME=
# ffmpeg, se não estiver no PATH.
FFMPEG_PATH=
